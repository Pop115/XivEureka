<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.10.0.0</Version>
    <Author>Pop115</Author>
    <Name>Xiv Eurêka</Name>
    <Punchline>Eureka companion: Logos actions, what to hit for missing logograms, NM map, live tracker.</Punchline>
    <Description>Reads your Logos mnemes and learned actions from the game and shows what you can craft; ranks every way to get the logograms you are missing (elementals, NMs, bunny coffers) by estimated time; redraws the Eureka map with NMs, prep areas, pops and the coming weather; follows the ffxiv-eureka.com tracker of your instance. In English, or in French on a French client.</Description>
    <Tags>eureka;logos;logograms;pyros;hydatos;nm;tracker;map</Tags>
    <RepoUrl>https://github.com/Pop115/XivEureka</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Pop115/XivEureka/main/XivEureka/images/icon.png</IconUrl>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\logos.json" LogicalName="XivEureka.Data.logos.json" />
    <EmbeddedResource Include="Data\nm.json" LogicalName="XivEureka.Data.nm.json" />
    <EmbeddedResource Include="Data\farms.json" LogicalName="XivEureka.Data.farms.json" />
    <EmbeddedResource Include="Data\relics.json" LogicalName="XivEureka.Data.relics.json" />
    <!-- Dalamud shows images/icon.png next to the DLL for dev plugins; IconUrl serves the installer. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
